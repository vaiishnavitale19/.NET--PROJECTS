          "name",
          "price",
          "stock"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "price": {
            "maximum": 1000000,
            "minimum": 15,
            "type": "number",
            "format": "double"
          },
          "stock": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "orderItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItems"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
